# --- Server ---
PORT=3000
NODE_ENV=development

# --- Firebase ---
# Auth works with just the project id. Firestore persistence needs a service account.
FIREBASE_PROJECT_ID=my-career-ai
# Path to a service-account JSON file, OR the JSON itself in FIREBASE_SERVICE_ACCOUNT_JSON.
# If neither is set the server falls back to a local JSON file store (data/store.json) - dev only.
# With credentials the default is STORE_MODE=snapshot: local file + compressed backup in Firestore (free-tier friendly).
# STORE_MODE=snapshot | firestore | file
# STORE_MODE=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local development only: accept "Authorization: Bearer dev:<uid>" without Firebase. Never enable in production.
DEV_AUTH_BYPASS=false

# --- AI gateway (server-side keys; users never supply keys) ---
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional second provider (any OpenAI-compatible API: Groq, OpenRouter, Together, ...)
FALLBACK_AI_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=llama-3.3-70b-versatile

# Daily AI credits per user (chat=1, job analysis=3, resume parse=5, tailored resume=8, ...)
DAILY_AI_CREDITS=100

# Encrypts stored API keys. Required in production; set once and never change it.
# APP_SECRET=

# Public site address (canonical links, sitemap, share tags)
SITE_URL=https://app.tiaslab.in

# Comma-separated emails allowed to use the Admin tab (connector health, manual discovery)
ADMIN_EMAILS=
# Per-user limit on expensive endpoints (chat, upload, tailoring), per minute
USER_RATE_LIMIT_PER_MIN=20

# --- Job sources ---
JOB_DISCOVERY_USER_AGENT=MyCareer.AI/1.0 (+https://app.tiaslab.in)
# Comma-separated public ATS feeds, e.g. https://boards-api.greenhouse.io/v1/boards/razorpay/jobs
PUBLIC_ATS_FEEDS=
# Company careers systems (Greenhouse, Lever, Ashby, SmartRecruiters, Workday, Oracle, Recruitee, Workable,
# schema.org careers pages) are read from the company registry: server/jobs/seed/companies.json + Admin → Company registry.
# Boards fetched per source per cycle (Workday/Oracle/careers pages use a quarter of this); the rest rotate on later cycles.
BOARDS_PER_RUN=40
MAX_JOBS_PER_BOARD=120
# Comma-separated connector ids to switch off, e.g. SOURCES_DISABLED=arbeitnow,remotive
SOURCES_DISABLED=

# Free aggregator APIs — each connector stays off until its key is set.
# Keys for Adzuna / Careerjet / Jooble can also be pasted in Admin → Job discovery (tested, stored encrypted).
# A key set here takes precedence over one pasted in Admin.
# Adzuna India: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Careerjet partner API (free): https://www.careerjet.com/partners — the referer must be the page that shows the results
CAREERJET_API_KEY=
CAREERJET_REFERER=
# Jooble REST API (free key): https://jooble.org/api/about
JOOBLE_API_KEY=

# Default background discovery interval in minutes (0 = start paused).
# Admin → Job discovery can change the interval, pause/resume, pace and per-source schedules at runtime.
DISCOVERY_INTERVAL_MINUTES=60

# Forward job-alert emails into the app (see deploy/cloudflare-email-worker.js).
# INBOUND_EMAIL_DOMAIN is the domain routed by Cloudflare Email Routing, e.g. in.example.com; the secret must match the worker.
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=

# Live voice with Asha (Gemini Live) runs on each user's own free Google key. Change the model only if Google renames it:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_MODEL=gemini-3.8-live
