rules_version = '2';

// MyCareer.AI reads and writes Firestore only from its own server (Firebase Admin SDK), which bypasses these rules.
// No browser or mobile client should ever touch the database directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
